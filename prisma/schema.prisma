generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String             @id @default(cuid())
  name                String
  email               String?            @unique
  loginId             String?            @unique
  passwordHash        String?
  mustChangePassword  Boolean            @default(false)
  role                String             @default("student")
  school              String?
  createdAt           DateTime           @default(now())
  studentProfile      StudentProfile?
  teacherProfile      TeacherProfile?
  communityProfile    CommunityProfile?
  mentorProfile       MentorProfile?
  supervisedStudents  StudentProfile[]   @relation("SupervisedStudents")
  createdTeams        Team[]             @relation("TeamCreator")
  submittedChallenges Challenge[]        @relation("ChallengeSubmitter")
  reviewedChallenges  Challenge[]        @relation("ChallengeReviewer")
  supervisedProjects  Project[]          @relation("ProjectSupervisor")
  projectUpdates      ProjectUpdate[]    @relation("ProjectAuthor")
  verifiedImpacts     ImpactRecord[]     @relation("ImpactVerifier")
  feedbackAuthored    Feedback[]         @relation("FeedbackAuthor")
  teamMembers         TeamMember[]
  assessments         Assessment[]
  notifications       Notification[]
  schoolMemberships   SchoolMembership[] @relation("MembershipUser")
  membershipsInvited  SchoolMembership[] @relation("MembershipInviter")
}

model School {
  id            String             @id @default(cuid())
  name          String
  district      String
  schoolCode    String?            @unique
  schoolType    String?
  country       String             @default("Uganda")
  location      String?
  subcounty     String?
  contactPhone  String?
  headteacher   String?
  status        String             @default("active")
  createdAt     DateTime           @default(now())
  students      StudentProfile[]
  teachers      TeacherProfile[]
  challenges    Challenge[]
  memberships   SchoolMembership[]
  classes       SchoolClass[]
  teams         Team[]
  projects      Project[]
  projectBriefs ProjectBrief[]
  updates       ProjectUpdate[]
  evidence      ProjectEvidence[]
  impactRecords ImpactRecord[]
  feedback      Feedback[]
  submissions   Submission[]
  assessments   Assessment[]
  notifications Notification[]
  resources     Resource[]
  ussdSessions  UssdSession[]

  @@unique([name, district])
  @@index([district])
}

model SchoolMembership {
  id                    String                      @id @default(cuid())
  schoolId              String
  userId                String
  role                  String
  status                String                      @default("active")
  invitedById           String?
  createdAt             DateTime                    @default(now())
  school                School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                  User                        @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy             User?                       @relation("MembershipInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  administratorProfile  SchoolAdministratorProfile?
  studentProfile        StudentProfile?
  teacherProfile        TeacherProfile?
  studentClasses        StudentClassMembership[]
  teacherAssignments    TeacherClassAssignment[]
  assignedClassStudents StudentClassMembership[]    @relation("ClassAssignmentAuthor")

  @@unique([schoolId, userId, role])
  @@index([userId, status])
  @@index([schoolId, role, status])
  @@index([invitedById])
}

model SchoolAdministratorProfile {
  id           String           @id @default(cuid())
  membershipId String           @unique
  title        String?
  createdAt    DateTime         @default(now())
  membership   SchoolMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

model SchoolClass {
  id           String                   @id @default(cuid())
  schoolId     String
  name         String
  classLevel   String
  academicYear String?
  createdAt    DateTime                 @default(now())
  school       School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students     StudentClassMembership[]
  teachers     TeacherClassAssignment[]

  @@unique([schoolId, name, academicYear])
  @@index([schoolId, classLevel])
}

model StudentClassMembership {
  id           String            @id @default(cuid())
  classId      String
  membershipId String
  assignedById String?
  status       String            @default("active")
  joinedAt     DateTime          @default(now())
  schoolClass  SchoolClass       @relation(fields: [classId], references: [id], onDelete: Cascade)
  student      SchoolMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  assignedBy   SchoolMembership? @relation("ClassAssignmentAuthor", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([classId, membershipId])
  @@index([membershipId, status])
  @@index([assignedById])
}

model TeacherClassAssignment {
  id           String           @id @default(cuid())
  classId      String
  membershipId String
  assignedAt   DateTime         @default(now())
  schoolClass  SchoolClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher      SchoolMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([classId, membershipId])
  @@index([membershipId])
}

model StudentProfile {
  id                   String            @id @default(cuid())
  userId               String            @unique
  schoolId             String?
  schoolMembershipId   String?           @unique
  classLevel           String
  educationLevel       String
  supervisingTeacherId String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  school               School?           @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  schoolMembership     SchoolMembership? @relation(fields: [schoolMembershipId], references: [id], onDelete: SetNull)
  supervisingTeacher   User              @relation("SupervisedStudents", fields: [supervisingTeacherId], references: [id], onDelete: Restrict)

  @@index([schoolId])
  @@index([supervisingTeacherId])
}

model TeacherProfile {
  id                 String            @id @default(cuid())
  userId             String            @unique
  schoolId           String?
  schoolMembershipId String?           @unique
  verified           Boolean           @default(false)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  school             School?           @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  schoolMembership   SchoolMembership? @relation(fields: [schoolMembershipId], references: [id], onDelete: SetNull)

  @@index([schoolId])
}

model CommunityProfile {
  id        String  @id @default(cuid())
  userId    String  @unique
  area      String?
  interests String  @default("[]")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MentorProfile {
  id     String @id @default(cuid())
  userId String @unique
  skills String @default("[]")
  status String @default("pending")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Challenge {
  id             String        @id @default(cuid())
  title          String
  category       String
  kind           String        @default("community")
  schoolName     String?
  schoolId       String?
  location       String
  description    String
  peopleAffected String?
  whyItMatters   String?
  possibleAreas  String?
  submittedById  String?
  reviewerId     String?
  difficulty     String        @default("Beginner")
  duration       String        @default("2–3 weeks")
  participants   Int           @default(0)
  color          String        @default("mint")
  icon           String        @default("bulb")
  status         String        @default("pending")
  contactPhone   String?
  createdAt      DateTime      @default(now())
  school         School?       @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  submittedBy    User?         @relation("ChallengeSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewer       User?         @relation("ChallengeReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  projectBrief   ProjectBrief?
  teams          Team[]
  submissions    Submission[]

  @@index([schoolId])
  @@index([submittedById])
  @@index([reviewerId])
  @@index([status, kind])
}

model ProjectBrief {
  id               String    @id @default(cuid())
  challengeId      String    @unique
  schoolId         String?
  projectTitle     String
  learnerLevel     String    @default("Lower secondary · Senior 1–4")
  subjects         String
  competencies     String    @default("[]")
  objectives       String
  activities       String
  materials        String    @default("[]")
  timeline         String    @default("[]")
  expectedOutcomes String    @default("[]")
  assessment       String
  safetyNote       String
  model            String?
  approved         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  challenge        Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  school           School?   @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId])
}

model Team {
  id          String       @id @default(cuid())
  name        String
  challengeId String
  schoolId    String?
  ownerId     String?
  createdAt   DateTime     @default(now())
  challenge   Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  school      School?      @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  owner       User?        @relation("TeamCreator", fields: [ownerId], references: [id], onDelete: SetNull)
  members     TeamMember[]
  submissions Submission[]
  project     Project?

  @@index([ownerId])
  @@index([challengeId])
  @@index([schoolId])
}

model Project {
  id                   String            @id @default(cuid())
  teamId               String            @unique
  schoolId             String?
  title                String
  problemStatement     String
  proposedSolution     String            @default("")
  objectives           String            @default("[]")
  availableResources   String            @default("[]")
  materialsNeeded      String            @default("[]")
  steps                String            @default("[]")
  estimatedDuration    String?
  safetyConsiderations String            @default("")
  expectedOutcomes     String            @default("[]")
  status               String            @default("idea")
  supervisorTeacherId  String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  team                 Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  school               School?           @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  supervisor           User?             @relation("ProjectSupervisor", fields: [supervisorTeacherId], references: [id], onDelete: SetNull)
  updates              ProjectUpdate[]
  evidence             ProjectEvidence[]
  impactRecords        ImpactRecord[]
  feedback             Feedback[]

  @@index([status])
  @@index([supervisorTeacherId])
  @@index([schoolId, status])
}

model ProjectUpdate {
  id           String            @id @default(cuid())
  projectId    String
  schoolId     String?
  authorId     String
  whatTried    String
  whatHappened String
  nextSteps    String
  createdAt    DateTime          @default(now())
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  school       School?           @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  author       User              @relation("ProjectAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  evidence     ProjectEvidence[]

  @@index([projectId, createdAt])
  @@index([authorId])
  @@index([schoolId])
}

model ProjectEvidence {
  id          String         @id @default(cuid())
  projectId   String
  schoolId    String?
  updateId    String?
  fileUrl     String
  fileName    String
  contentType String
  createdAt   DateTime       @default(now())
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  school      School?        @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  update      ProjectUpdate? @relation(fields: [updateId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([updateId])
  @@index([schoolId])
}

model ImpactRecord {
  id           String   @id @default(cuid())
  projectId    String
  schoolId     String?
  metric       String
  value        Int
  unit         String
  evidenceNote String?
  status       String   @default("reported")
  verifiedById String?
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  school       School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  verifiedBy   User?    @relation("ImpactVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([verifiedById])
  @@index([schoolId, status])
}

model Feedback {
  id        String   @id @default(cuid())
  projectId String
  schoolId  String?
  authorId  String
  content   String
  moderated Boolean  @default(false)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  author    User     @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId, moderated])
  @@index([authorId])
  @@index([schoolId])
}

model TeamMember {
  id         String   @id @default(cuid())
  teamId     String
  userId     String
  memberRole String   @default("student")
  joinedAt   DateTime @default(now())
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Submission {
  id                String      @id @default(cuid())
  title             String
  description       String
  evidence          String      @default("[]")
  status            String      @default("submitted")
  peopleHelped      Int         @default(0)
  materialsReused   Int         @default(0)
  problemsAddressed Int         @default(0)
  sharedPublicly    Boolean     @default(false)
  teamId            String
  challengeId       String
  schoolId          String?
  createdAt         DateTime    @default(now())
  team              Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  challenge         Challenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  school            School?     @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  assessment        Assessment?

  @@index([schoolId, status])
}

model Assessment {
  id               String     @id @default(cuid())
  submissionId     String     @unique
  teacherId        String
  score            Int?
  feedback         String
  badge            String?
  publiclyApproved Boolean    @default(false)
  createdAt        DateTime   @default(now())
  submission       Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  teacher          User       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolId         String?
  school           School?    @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  phone     String?
  channel   String   @default("in-app")
  message   String
  status    String   @default("queued")
  createdAt DateTime @default(now())
  schoolId  String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
}

model Resource {
  id        String   @id @default(cuid())
  title     String
  subject   String
  summary   String
  url       String?
  createdAt DateTime @default(now())
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId, subject])
}

model UssdSession {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  phoneNumber String
  state       String   @default("menu")
  answers     String   @default("{}")
  updatedAt   DateTime @updatedAt
  schoolId    String?
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId, updatedAt])
}
