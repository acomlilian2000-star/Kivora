generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  name        String
  email       String?      @unique
  role        String       @default("student")
  school      String?
  createdAt   DateTime     @default(now())
  teamMembers TeamMember[]
  assessments Assessment[]
  notifications Notification[]
}

model Challenge {
  id            String        @id @default(cuid())
  title         String
  category      String
  location      String
  description   String
  difficulty    String        @default("Beginner")
  duration      String        @default("2–3 weeks")
  participants  Int           @default(0)
  color         String        @default("mint")
  icon          String        @default("bulb")
  status        String        @default("pending")
  contactPhone  String?
  createdAt     DateTime      @default(now())
  projectBrief  ProjectBrief?
  teams         Team[]
  submissions   Submission[]
}

model ProjectBrief {
  id          String    @id @default(cuid())
  challengeId String    @unique
  projectTitle String
  learnerLevel String   @default("Lower secondary · Senior 1–4")
  subjects    String
  competencies String   @default("[]")
  objectives  String
  activities  String
  assessment String
  safetyNote  String
  model       String?
  approved    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}

model Team {
  id          String       @id @default(cuid())
  name        String
  challengeId String
  createdAt   DateTime     @default(now())
  challenge   Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  submissions Submission[]
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  memberRole String @default("student")
  joinedAt  DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Submission {
  id          String       @id @default(cuid())
  title       String
  description String
  evidence    String       @default("[]")
  status      String       @default("submitted")
  teamId      String
  challengeId String
  createdAt   DateTime     @default(now())
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  challenge   Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  assessment  Assessment?
}

model Assessment {
  id           String     @id @default(cuid())
  submissionId String     @unique
  teacherId    String
  score        Int?
  feedback     String
  badge        String?
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  teacher      User       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  phone     String?
  channel   String   @default("in-app")
  message   String
  status    String   @default("queued")
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Resource {
  id        String   @id @default(cuid())
  title     String
  subject   String
  summary   String
  url       String?
  createdAt DateTime @default(now())
}

model UssdSession {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  phoneNumber String
  state       String   @default("menu")
  answers     String   @default("{}")
  updatedAt   DateTime @updatedAt
}
